# Dummy values for local development. Copy to .env (untracked) and adjust.
POLISHED_DB_PATH=./data/polished.db
POLISHED_PUBLIC_URL=http://localhost:8080
POLISHED_AUTH_MODE=none
POLISHED_SESSION_SECRET=dev-secret-dev-secret-dev-secret-00
POLISHED_SYNC_ENABLED=false

# Only for AUTH_MODE=oidc (the cluster); the real values come from the operator-written Secret.
# POLISHED_OIDC_ISSUER=https://id.janpuc.com
# POLISHED_OIDC_CLIENT_ID=dummy-client-id
# POLISHED_OIDC_CLIENT_SECRET=dummy-client-secret
# POLISHED_OIDC_ALLOWED_GROUPS=ID-Users,ID-Admin
