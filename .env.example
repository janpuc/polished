# Dummy values for local development. Copy to .env (untracked) and adjust.
POLISHED_DB_PATH=./data/polished.db
POLISHED_PUBLIC_URL=http://localhost:8080
POLISHED_AUTH_MODE=none
POLISHED_SESSION_SECRET=dev-secret-dev-secret-dev-secret-00
POLISHED_SYNC_ENABLED=false
# Holo Taco's release list (Google Sheet CSV) is read after each sync; empty turns it off.
# POLISHED_RELEASE_SHEET_URL=

# Only for AUTH_MODE=oidc (the cluster); the real values come from the operator-written Secret.
# POLISHED_OIDC_ISSUER=https://id.janpuc.com
# POLISHED_OIDC_CLIENT_ID=dummy-client-id
# POLISHED_OIDC_CLIENT_SECRET=dummy-client-secret
# POLISHED_OIDC_ALLOWED_GROUPS=ID-Users,ID-Admin

# The native app. The Apple team ID (public: it appears in the universal-link file) turns on
# /.well-known/apple-app-site-association; empty keeps that route off.
POLISHED_APPLE_TEAM_ID=RW5T9P5A59
# Only with POLISHED_AUTH_MODE=none (refused otherwise): a fixed bearer token for /api/v1, so curl
# and the app's UI tests need no sign-in, and a template database that POST /__test/reset (loopback
# only) copies over the live one.
# POLISHED_DEV_TOKEN=dev
# POLISHED_TEST_RESET_FROM=./data/template.db
