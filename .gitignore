.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Runtime data: the SQLite database, its WAL files and uploaded photos never go in git.
/data/
*.db
*.db-*
*.sqlite3
/photos/
/uploads/

# Secrets and local config.
.env
.env.*
!.env.example

# The Shopify snapshot is public data but 4 MB of noise; tests use the trimmed fixtures
# in tests/fixtures/. research/scripts/ stays tracked.
/research/*.json

.DS_Store

# apple-design is a local-only skill (no license to redistribute it).
/.pi/skills/apple-design/

# The native app (app/): the Xcode project is generated by `xcodegen generate`; the team ID file is
# local (app/Team.xcconfig.example is the template).
/app/Polished.xcodeproj/
/app/Team.xcconfig
/app/PolishedCore/.build/
/app/PolishedCore/.swiftpm/
DerivedData/
build/
*.xcresult
*.xcuserstate
xcuserdata/
/app/Polished/Info.plist
/app/PolishedWidgets/Info.plist
